# ─────────────────────────────────────────────────────────────
# NFM Testbed 5G — contoh environment. Salin ke .env lalu sesuaikan.
#   cp .env.example .env
# .env TIDAK di-commit (lihat .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Identitas PLMN (harus konsisten di Open5GS + UERANSIM) ---
MCC=999
MNC=70
# TAC & slice default Open5GS
TAC=1
SST=1
SD=0xffffff

# --- Kunci subscriber uji (nilai default docker_open5gs; ganti utk riset) ---
# K = secret key, OPC = operator key. Sama untuk semua UE uji kecuali diubah.
SUBS_K=465B5CE8B199B49FAA5F0A2EE238A6BC
SUBS_OPC=E8ED289DEBA952E4283B54E88E6183CA
# IMSI diawali MCC+MNC; add_subs.sh menambah nomor urut.
IMSI_BASE=999700000000001

# --- Versi image 5G ---
# Open5GS: pakai tag RENTAN utk reproduksi CVE Tier 1-4 (lihat README).
#   CVE-2021-45462 / CVE-2024-24429 / CVE-2024-51179 → Open5GS <= 2.7.5
# Verifikasi tag tersedia sebelum build (scripts/setup_vm.sh mengecek).
OPEN5GS_VERSION=2.7.5
UERANSIM_VERSION=3.2.6
MONGO_VERSION=6.0

# --- OpenVAS / Greenbone (profile scanner) ---
OPENVAS_PASSWORD=changeme_lab_only
OPENVAS_UI_PORT=9392

# --- Subnet lab (JANGAN ubah tanpa menyesuaikan compose + guard) ---
NET_CP=172.22.0.0/24
NET_UP=172.23.0.0/24
NET_DN=172.24.0.0/24
NET_UE=10.45.0.0/16

# --- TLS SBI ---
# true  = SBI over TLS (3GPP TS 33.501) — kondisi utama testbed
# false = SBI plaintext — pembanding (Tier 5 nilai riset)
SBI_TLS=true
